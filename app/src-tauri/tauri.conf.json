{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "IconState",
    "version": "0.0.0",
    "identifier": "com.ilkerbalcilar.iconstate",
    "build": {
        "beforeDevCommand": "../scripts/build-sidecar.sh && bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build && ../scripts/build-sidecar.sh",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "IconState",
                "width": 452,
                "height": 944,
                "minWidth": 340,
                "minHeight": 700,
                "decorations": false,
                "transparent": true,
                "shadow": false
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["$HOME/.iconstate/icons/**"]
            }
        },
        "macOSPrivateApi": true
    },
    "bundle": {
        "active": true,
        "targets": ["app", "dmg"],
        "category": "Utility",
        "shortDescription": "iPhone home screen editor",
        "externalBin": ["binaries/iconstate-core"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "minimumSystemVersion": "12.0"
        }
    }
}
