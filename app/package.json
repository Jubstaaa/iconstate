{
    "name": "iconstate",
    "private": true,
    "version": "0.1.2",
    "description": "iPhone home screen editor",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jubstaaa/iconstate.git",
        "directory": "app"
    },
    "packageManager": "bun@1.4.4",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "lint": "oxlint --deny-warnings",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "check": "bun run lint && bun run typecheck && bun run format:check && bun run test",
        "audit": "bun audit --audit-level=high"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-opener": "^2.7.3",
        "@tauri-apps/plugin-process": "^2.4.0",
        "@tauri-apps/plugin-updater": "^2.14.1",
        "motion": "^14.13.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.8"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "oxlint": "^1.94.0",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
